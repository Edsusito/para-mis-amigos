-- ==================== FAST ATTACK ====================
local function AttackMultipleTargets(targets)
    pcall(function()
        if not targets or #targets == 0 then return end
        local allTargets = {}
        for _, t in pairs(targets) do
            local head = t:FindFirstChild("Head")
            if head then table.insert(allTargets, {t, head}) end
        end
        if #allTargets == 0 then return end
        RegisterAttack:FireServer(0)
        RegisterHit:FireServer(allTargets[1][2], allTargets)
    end)
end

local function StartFastAttack()
    if FastAttackConnection then task.cancel(FastAttackConnection) end
    FastAttackConnection = task.spawn(function()
        while Config.FastAttack and Config.Enabled do
            task.wait(Config.AttackDelay)
            local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if not myHRP then continue end

            local list = {}
            local enemies = workspace:FindFirstChild("Enemies")
            if enemies then
                for _, npc in pairs(enemies:GetChildren()) do
                    local hum = npc:FindFirstChild("Humanoid")
                    local hrp = npc:FindFirstChild("HumanoidRootPart")
                    if hum and hrp and hum.Health > 0 then
                        local dist = (hrp.Position - myHRP.Position).Magnitude
                        if dist <= Config.Range then
                            table.insert(list, {char = npc, dist = dist})
                        end
                    end
                end
            end
            table.sort(list, function(a,b) return a.dist < b.dist end)
            local final = {}
            for i = 1, math.min(3, #list) do table.insert(final, list[i].char) end
            if #final > 0 then AttackMultipleTargets(final) end
        end
    end)
end

local function StopFastAttack()
    if FastAttackConnection then task.cancel(FastAttackConnection) FastAttackConnection = nil end
end

-- ==================== ANTI-DESYNC MAGNET ====================
local function ForceNPC(nhrp, hum, targetCF)
    -- Método más agresivo posible desde cliente
    pcall(function()
        nhrp.CFrame = targetCF
        nhrp.AssemblyLinearVelocity = Vector3.zero
        nhrp.AssemblyAngularVelocity = Vector3.zero
        nhrp.CanCollide = false
        nhrp.Anchored = false

        if hum then
            hum.PlatformStand = true
            hum.WalkSpeed = 0
            hum.JumpPower = 0
            hum.AutoRotate = false
        end
    end)
end

local function GetClosestTargets(hrp)
    local enemies = workspace:FindFirstChild("Enemies")
    if not enemies then return {} end
    local list = {}
    for _, npc in pairs(enemies:GetChildren()) do
        local nhrp = npc:FindFirstChild("HumanoidRootPart")
        local hum = npc:FindFirstChild("Humanoid")
        if nhrp and hum and hum.Health > 0 then
            local dist = (nhrp.Position - hrp.Position).Magnitude
            if dist <= Config.Range then
                table.insert(list, {npc = npc, hrp = nhrp, hum = hum, dist = dist})
            end
        end
    end
    table.sort(list, function(a,b) return a.dist < b.dist end)
    local res = {}
    for i = 1, math.min(Config.MaxTargets, #list) do
        table.insert(res, list[i])
    end
    return res
end

local function GetNearestPlayerHRP(fromHRP)
    local closest, closestDist = nil, math.huge
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local dist = (plr.Character.HumanoidRootPart.Position - fromHRP.Position).Magnitude
            if dist < closestDist and dist < 2000 then
                closestDist = dist
                closest = plr.Character.HumanoidRootPart
            end
        end
    end
    return closest
end

local function StartMagnet()
    if MagnetConnection then MagnetConnection:Disconnect() end

    -- Forzar SimulationRadius constantemente
    pcall(function()
        sethiddenproperty(LocalPlayer, "SimulationRadius", math.huge)
    end)

    MagnetConnection = RunService.Heartbeat:Connect(function(dt)
        if not Config.Enabled then return end

        -- Reaplicar SimulationRadius cada frame (ayuda)
        pcall(function()
            sethiddenproperty(LocalPlayer, "SimulationRadius", math.huge)
        end)

        Time = Time + dt * Config.MoveSpeed

        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        local targets = GetClosestTargets(hrp)
        local total = math.max(#targets, 1)
        local d = Config.Distance

        for i, data in ipairs(targets) do
            local nhrp = data.hrp
            local hum = data.hum
            local idx = i - 1
            local mode = Config.Position
            local targetCF

            if mode == "Escudo" then
                local golden = math.pi * (3 - math.sqrt(5))
                local y = 1 - (idx / math.max(total-1,1)) * 2
                local r = math.sqrt(math.max(0, 1 - y*y))
                local theta = golden * idx
                targetCF = hrp.CFrame * CFrame.new(math.cos(theta)*r*d, y*d, math.sin(theta)*r*d)

            elseif mode == "Fila" then
                local spacing = 3.5
                local start = -((total-1)*spacing)/2
                targetCF = hrp.CFrame * CFrame.new(start + idx*spacing, -1, -d)

            elseif mode == "Circulo" then
                local base = (idx / total) * math.pi * 2
                local angle = base + Time * 1.1
                targetCF = hrp.CFrame * CFrame.new(math.cos(angle)*d, -1, math.sin(angle)*d)

            elseif mode == "Torre" then
                targetCF = hrp.CFrame * CFrame.new(0, idx * 4.2, -2)

            elseif mode == "Bounce" then
                local speed = 1.6
                local x = math.sin(Time * speed + idx * 1.7) * d
                local y = math.abs(math.sin(Time * speed * 1.2 + idx * 2.0)) * (d * 0.7) - 1
                local z = math.cos(Time * speed * 0.85 + idx * 1.3) * d
                targetCF = hrp.CFrame * CFrame.new(x, y, z)

            elseif mode == "Troll1" then
                local target = GetNearestPlayerHRP(hrp)
                if target then
                    local off = CFrame.new((idx%4)-1.5, 0, math.floor(idx/4)*1.5)
                    targetCF = target.CFrame * off
                else
                    targetCF = hrp.CFrame * CFrame.new(0, -1, -d)
                end

            elseif mode == "Troll2" then
                local target = GetNearestPlayerHRP(hrp)
                if target then
                    local pulse = (math.sin(Time * 2.8 + idx * 0.7) + 1) / 2
                    local dist = 5 + pulse * 11
                    local angle = (idx / total) * math.pi * 2 + Time * 0.5
                    targetCF = target.CFrame * CFrame.new(math.cos(angle)*dist, 1, math.sin(angle)*dist)
                else
                    targetCF = hrp.CFrame * CFrame.new(0, -1, -d)
                end

            else -- Frente
                targetCF = hrp.CFrame * CFrame.new(0, -1.2, -d)
            end

            ForceNPC(nhrp, hum, targetCF)
        end
    end)
end

local function StopScript()
    Config.Enabled = false
    StopFastAttack()
    if MagnetConnection then MagnetConnection:Disconnect() MagnetConnection = nil end
end

local function Toggle()
    Config.Enabled = not Config.Enabled
    UpdateButtons()
    if Config.Enabled then
        StartMagnet()
        if Config.FastAttack then StartFastAttack() end
    else
        StopScript()
    end
end

