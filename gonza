    -- ==========================================================
    --  FUNCIONES PARA CREAR ELEMENTOS UI
    -- ==========================================================

    local function createSectionTitle(text, order)
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, 0, 0, 20)
        label.BackgroundTransparency = 1
        label.Text = "> " .. text
        label.TextColor3 = Color3.fromRGB(255, 255, 255)
        label.TextSize = 13
        label.Font = Enum.Font.Code
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.TextYAlignment = Enum.TextYAlignment.Center
        label.LayoutOrder = order
        label.Parent = scrollFrame
        label.ZIndex = 3
        return label
    end

    local function createToggleRow(labelText, defaultValue, onToggle, order)
        local row = Instance.new("Frame")
        row.Size = UDim2.new(1, 0, 0, 30)
        row.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        row.BackgroundTransparency = 0
        row.BorderSizePixel = 0
        row.LayoutOrder = order
        row.Parent = scrollFrame
        row.ZIndex = 2

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(0.7, 0, 1, 0)
        label.Position = UDim2.new(0, 4, 0, 0)
        label.BackgroundTransparency = 1
        label.Text = labelText
        label.TextColor3 = Color3.fromRGB(220, 220, 220)
        label.TextSize = 13
        label.Font = Enum.Font.Code
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.TextYAlignment = Enum.TextYAlignment.Center
        label.Parent = row
        label.ZIndex = 3

        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0, 60, 0, 24)
        btn.Position = UDim2.new(0.85, 0, 0.1, 0)
        btn.BackgroundColor3 = defaultValue and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(40, 40, 40)
        btn.Text = defaultValue and "ON" or "OFF"
        btn.TextColor3 = defaultValue and Color3.fromRGB(0, 0, 0) or Color3.fromRGB(130, 130, 130)
        btn.TextSize = 12
        btn.Font = Enum.Font.Code
        btn.BorderSizePixel = 0
        btn.Parent = row
        btn.ZIndex = 3

        local btnCorner = Instance.new("UICorner")
        btnCorner.CornerRadius = UDim.new(0, 3)
        btnCorner.Parent = btn

        local state = defaultValue
        btn.MouseButton1Click:Connect(function()
            state = not state
            if state then
                btn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                btn.Text = "ON"
                btn.TextColor3 = Color3.fromRGB(0, 0, 0)
            else
                btn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
                btn.Text = "OFF"
                btn.TextColor3 = Color3.fromRGB(130, 130, 130)
            end
            onToggle(state)
        end)

        return row, btn
    end

    local function createSliderRow(labelText, minVal, maxVal, defaultVal, onValueChange, order)
        local row = Instance.new("Frame")
        row.Size = UDim2.new(1, 0, 0, 30)
        row.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        row.BackgroundTransparency = 0
        row.BorderSizePixel = 0
        row.LayoutOrder = order
        row.Parent = scrollFrame
        row.ZIndex = 2

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(0.4, 0, 1, 0)
        label.Position = UDim2.new(0, 4, 0, 0)
        label.BackgroundTransparency = 1
        label.Text = labelText .. ": " .. tostring(defaultVal)
        label.TextColor3 = Color3.fromRGB(220, 220, 220)
        label.TextSize = 12
        label.Font = Enum.Font.Code
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.TextYAlignment = Enum.TextYAlignment.Center
        label.Parent = row
        label.ZIndex = 3

        local sliderFrame = Instance.new("Frame")
        sliderFrame.Size = UDim2.new(0.5, 0, 0, 8)
        sliderFrame.Position = UDim2.new(0.45, 0, 0.35, 0)
        sliderFrame.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
        sliderFrame.BorderSizePixel = 0
        sliderFrame.Parent = row
        sliderFrame.ZIndex = 2

        local fill = Instance.new("Frame")
        local ratio = (defaultVal - minVal) / (maxVal - minVal)
        fill.Size = UDim2.new(ratio, 0, 1, 0)
        fill.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        fill.BorderSizePixel = 0
        fill.Parent = sliderFrame
        fill.ZIndex = 3

        local dragging = false
        local currentValue = defaultVal

        local function updateSlider(position)
            local rel = math.clamp((position.X - sliderFrame.AbsolutePosition.X) / sliderFrame.AbsoluteSize.X, 0, 1)
            local value = math.round(minVal + rel * (maxVal - minVal))
            value = math.clamp(value, minVal, maxVal)
            if value ~= currentValue then
                currentValue = value
                fill.Size = UDim2.new((value - minVal) / (maxVal - minVal), 0, 1, 0)
                label.Text = labelText .. ": " .. tostring(value)
                onValueChange(value)
            end
        end

        sliderFrame.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = true
                updateSlider(input.Position)
            end
        end)

        sliderFrame.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = false
            end
        end)

        UserInputService.InputChanged:Connect(function(input)
            if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                updateSlider(input.Position)
            end
        end)

        return row
    end

    -- ==========================================================
    --  CONSTRUCCIÓN DE LA GUI (TODOS LOS ELEMENTOS)
    -- ==========================================================

    local order = 0

    -- Aimbot General
    order = order + 1
    createSectionTitle("Aimbot General", order)

    order = order + 1
    createToggleRow("Aimbot", false, function(state)
        aimbotOn = state
