        boostDuration = value / 100
    end, order)

    -- No GFX
    order = order + 1
    createSectionTitle("No GFX", order)

    order = order + 1
    createToggleRow("No GFX", false, function(state)
        noGfxEnabled = state
        if state then
            task.spawn(startNoGfx)
        else
            task.spawn(restoreNoGfx)
        end
    end, order)

    -- Botón de acción: Cerrar Panel
    order = order + 1
    local closePanelBtn = Instance.new("TextButton")
    closePanelBtn.Size = UDim2.new(1, 0, 0, 30)
    closePanelBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    closePanelBtn.Text = "Cerrar Panel"
    closePanelBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
    closePanelBtn.TextSize = 12
    closePanelBtn.Font = Enum.Font.Code
    closePanelBtn.BorderSizePixel = 0
    closePanelBtn.LayoutOrder = order
    closePanelBtn.Parent = scrollFrame
    closePanelBtn.ZIndex = 3

    closePanelBtn.MouseButton1Click:Connect(function()
        guiVisible = false
        mainFrame.Visible = false
        floatBtn.ImageColor3 = Color3.fromRGB(100, 100, 100)
    end)

    -- ==========================================================
    --  BOTÓN FLOTANTE "G": MOSTRAR/OCULTAR GUI
    -- ==========================================================

    floatBtn.MouseButton1Click:Connect(function()
        guiVisible = not guiVisible
        mainFrame.Visible = guiVisible
        if guiVisible then
            floatBtn.ImageColor3 = Color3.fromRGB(200, 200, 200)
        else
            floatBtn.ImageColor3 = Color3.fromRGB(100, 100, 100)
        end
    end)

    return sg
end

