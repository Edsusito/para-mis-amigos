-- ============================================================
--  NO GFX (SIN MODIFICAR)
-- ============================================================

local function processNoGfxObject(inst)
    pcall(function()
        local className = inst.ClassName
        if className == "Beam" or className == "Trail" then
            if not noGfxModifiedObjects[inst] then
                noGfxModifiedObjects[inst] = { Texture = inst.Texture }
                inst.Texture = "rbxassetid://84308155859778"
            end
        elseif className == "ParticleEmitter" then
            if not noGfxModifiedObjects[inst] then
                noGfxModifiedObjects[inst] = { Texture = inst.Texture, Enabled = inst.Enabled }
                inst.Texture = ""
                inst.Enabled = false
            end
        end
    end)
end

local function restoreNoGfx()
    for obj, data in pairs(noGfxModifiedObjects) do
        pcall(function()
            if data.Texture ~= nil then obj.Texture = data.Texture end
            if data.Enabled ~= nil then obj.Enabled = data.Enabled end
        end)
    end
    noGfxModifiedObjects = {}
    for iconLabel, oldImage in pairs(noGfxHotbarIcons) do
        pcall(function() iconLabel.Image = oldImage or "" end)
    end
    noGfxHotbarIcons = {}
    if noGfxDescConn then noGfxDescConn:Disconnect(); noGfxDescConn = nil end
    if noGfxHotbarConn then noGfxHotbarConn:Disconnect(); noGfxHotbarConn = nil end
end

local function startNoGfx()
    restoreNoGfx()
    task.spawn(function()
        local descendants = workspace:GetDescendants()
        for i = 1, #descendants do
            local inst = descendants[i]
            if not inst:IsA("Terrain") and not inst:IsA("Camera") then
                processNoGfxObject(inst)
            end
            if i % 100 == 0 then RunService.Heartbeat:Wait() end
        end
    end)
    noGfxDescConn = workspace.DescendantAdded:Connect(processNoGfxObject)
    task.spawn(function()
        local backpackGui = playerGui:FindFirstChild("Backpack") or playerGui:FindFirstChild("Main")
        if not backpackGui then return end
        local hotbar = backpackGui:FindFirstChild("Hotbar") or backpackGui
        local container = hotbar and (hotbar:FindFirstChild("Container") or hotbar)
        if not container then return end
        local function updateIcons()
            for _, slot in ipairs(container:GetChildren()) do
                local iconLabel = slot:FindFirstChild("Icon") or slot:FindFirstChild("Image") or slot:FindFirstChildOfClass("ImageLabel")
                if iconLabel and iconLabel:IsA("ImageLabel") then
                    if not noGfxHotbarIcons[iconLabel] then
                        noGfxHotbarIcons[iconLabel] = iconLabel.Image
                    end
                    iconLabel.Image = "rbxassetid://84308155859778"
                    iconLabel.ImageColor3 = Color3.fromRGB(255, 255, 255)
                end
            end
        end
        updateIcons()
        noGfxHotbarConn = container.ChildAdded:Connect(function()
            task.defer(updateIcons)
        end)
    end)
end

