    order = order + 1
    createToggleRow("Portal Z", false, function(state)
        portalAimbotOn = state
        if not state then portalSkillKey = nil end
    end, order)

    -- Z Boost
    order = order + 1
    createSectionTitle("Z Boost", order)

    order = order + 1
    local boostToggleRow, boostToggleBtn = createToggleRow("Boost", true, function(state)
        boostEnabled = state
        if state then
            createBoostButton()
        else
            destroyBoostButton()
        end
    end, order)

    -- Crear el botón Z si el toggle está activo por defecto (está en true)
    createBoostButton()

    order = order + 1
    createSliderRow("Potencia", 100, 1500, velocityPower, function(value)
        velocityPower = value
    end, order)

    order = order + 1
