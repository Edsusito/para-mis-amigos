-- ==========================================
-- Esta es la mente matemática: busca la mejor salida si se atasca
local function FindBestEscapeRoute(hrp, raycastParams)
    local bestDir = Vector3.new(0, 0, 1)
    local maxClearDistance = 0
    
    -- Dispara 8 rayos en círculo (cada 45 grados) a 25 studs de distancia
    for i = 0, 7 do
        local angle = math.rad(i * 45)
        local scanDir = Vector3.new(math.cos(angle), 0, math.sin(angle))
        
        local rayHit = workspace:Raycast(hrp.Position, scanDir * 25, raycastParams)
        local currentDist = 25 -- Si no toca nada, la distancia es el máximo (25)
        
        if rayHit then
            currentDist = (rayHit.Position - hrp.Position).Magnitude
        end
        
        -- Si esta dirección está más despejada que las anteriores, la guardamos
        if currentDist > maxClearDistance then
            maxClearDistance = currentDist
            bestDir = scanDir
        end
    end
    
    -- Devuelve el mejor ángulo en grados
    return math.deg(math.atan2(bestDir.Z, bestDir.X))
end

local function startWalkingAI()
    local char = player.Character or player.CharacterAdded:Wait()
    local humanoid = char:WaitForChild("Humanoid")
    local hrp = char:WaitForChild("HumanoidRootPart")
    
    local currentAngle = math.random(0, 360)
    local walkDistance = 15 
    
    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = {char}
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude

    task.spawn(function()
        while isAntiAfkActive do
            if not char or not humanoid or humanoid.Health <= 0 then
                isAntiAfkActive = false
                break
            end
            
            local radians = math.rad(currentAngle)
            local dirVector = Vector3.new(math.cos(radians), 0, math.sin(radians))
            
            -- SENSOR FRONTAL BÁSICO (Para caminar normal)
            local frontHit = workspace:Raycast(hrp.Position, dirVector * 8, raycastParams)
            
            if frontHit then
                -- Si ve un muro de frente, usa su mente para elegir la mejor ruta
                StatusLabel.Text = "Estado: Muro. Analizando salida..."
                currentAngle = FindBestEscapeRoute(hrp, raycastParams)
                humanoid.Jump = true
                task.wait(0.2)
            else
                -- CAMINO DESPEJADO: A caminar
                StatusLabel.Text = "Estado: Caminando fluido..."
                local targetPoint = hrp.Position + (dirVector * walkDistance)
                
                local oldPos = hrp.Position
                humanoid:MoveTo(targetPoint)
                
                task.wait(0.5) -- Pausa para dar los pasos
                
                -- DETECTOR DE ATASCOS INVISIBLES
                local distanceMoved = (hrp.Position - oldPos).Magnitude
                if distanceMoved < 1.2 then
                    -- ¡SE QUEDÓ TRABADO! Resolución de problemas extrema:
                    StatusLabel.Text = "Estado: ¡Atasco! Escáner 360° activado"
                    
                    -- Llama al radar para buscar la zona más libre
                    currentAngle = FindBestEscapeRoute(hrp, raycastParams)
                    
                    -- Maniobra de escape: Salta y trata de forzar el paso
                    humanoid.Jump = true
                    
                    -- Si está MUY atascado (en una esquina rara), retrocede un poco
                    if distanceMoved < 0.2 then
                        local backwardPoint = hrp.Position - (dirVector * 5)
                        humanoid:MoveTo(backwardPoint)
                        task.wait(0.3)
                    end
                end
                
                -- MOVIMIENTO ORGÁNICO
                if math.random(1, 8) == 1 then
                    currentAngle = currentAngle + math.random(-30, 30) -- Giros ligeros
                end
                if math.random(1, 20) == 1 then
                    humanoid.Jump = true -- Salto random
                end
            end
        end
        
        ToggleBtn.Text = "INICIAR RONDÍN"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
        StatusLabel.Text = "Estado: Inactivo"
        if char and humanoid then
            humanoid:MoveTo(hrp.Position)
        end
    end)
end

