-- ==========================================================
local FastAttackEnabled = false
local FastAttackRange = 1200
local FastThread = nil

local function DoFastAttack()
    local char = localPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool then return end
    local wt = tool:GetAttribute("WeaponType")
    if wt ~= "Melee" and wt ~= "Sword" then return end
    local myPos = hrp.Position
    local targets = {}
    for _, v in ipairs(GetEnemies()) do
        local vhrp = v:FindFirstChild("HumanoidRootPart")
        if vhrp and (vhrp.Position - myPos).Magnitude <= FastAttackRange then
            for _, part in ipairs(v:GetChildren()) do
                if part:IsA("BasePart") then targets[#targets + 1] = { v, part } end
            end
        end
    end
    if #targets > 0 then
        pcall(function()
            local net = require(ReplicatedStorage.Modules.Net)
            net["RE/RegisterAttack"]:FireServer()
            local head = targets[1][1]:FindFirstChild("Head")
            if head then net["RE/RegisterHit"]:FireServer(head, targets) end
        end)
    end
end

local function ToggleFastAttack(v)
    FastAttackEnabled = v
    if v then
        FastThread = T.spawn(function()
            while FastAttackEnabled do
                pcall(DoFastAttack)
                T.wait(0.01)
            end
        end)
    elseif FastThread then
        T.cancel(FastThread)
        FastThread = nil
    end
end

