local function GuiParent()
    local ok, hui = pcall(function() return gethui() end)
    if ok and hui then return hui end
    return CoreGui
end

local BgImageUrl = "https://c4.wallpaperflare.com/wallpaper/1002/718/547/anime-monochrome-anime-girls-selective-coloring-hd-wallpaper-preview.jpg"
local BgImageFile = "EdsusitoBg.jpg"

local function GetBgAsset()
    local ok1, cached = pcall(getcustomasset, BgImageFile)
    if ok1 and cached and tostring(cached):find("rbxasset") then return cached end
    if REQUEST and writefile then
        local okReq, res = pcall(function()
            return REQUEST({ Url = BgImageUrl, Method = "GET", Headers = { ["User-Agent"] = "Mozilla/5.0" }, Binary = true })
        end)
        if okReq and res and res.Body and #res.Body > 0 then
            pcall(writefile, BgImageFile, res.Body)
            local okAsset, asset = pcall(getcustomasset, BgImageFile)
            if okAsset and asset then return asset end
        end
    end
    return nil
end

