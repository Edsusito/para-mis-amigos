local function GetEnemies()
    local list = {}
    for _, folderName in ipairs({ "Enemies", "Characters" }) do
        local folder = Workspace:FindFirstChild(folderName)
        if folder then
            for _, v in ipairs(folder:GetChildren()) do
                if v:IsA("Model") and v ~= character and v:FindFirstChild("HumanoidRootPart") then
                    local hum = v:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 then list[#list + 1] = v end
                end
            end
        end
    end
    return list
end

local function GetClosest(range)
    if not humanoidRootPart then return nil end
    local myPos = humanoidRootPart.Position
    local best, bestD = nil, range or 1e9
    for _, v in ipairs(GetEnemies()) do
        local hrp = v:FindFirstChild("HumanoidRootPart")
        if hrp then
            local d = (hrp.Position - myPos).Magnitude
            if d < bestD then best, bestD = v, d end
        end
    end
    return best
end

