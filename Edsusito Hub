local HitboxEnabled = false
local HitboxSize = 4
local HitboxThread = nil

local function ApplyHitboxes()
    for _, v in ipairs(GetEnemies()) do
        local hrp = v:FindFirstChild("HumanoidRootPart")
        if hrp then
            if not hrp:GetAttribute("EdsOrigSize") then hrp:SetAttribute("EdsOrigSize", hrp.Size) end
            local base = hrp:GetAttribute("EdsOrigSize") or hrp.Size
            local maxSide = math.max(base.X, base.Y, base.Z)
            hrp.Size = Vector3.new(maxSide * HitboxSize, maxSide * HitboxSize, maxSide * HitboxSize)
        end
    end
end

local function RestoreHitboxes()
    for _, v in ipairs(GetEnemies()) do
        local hrp = v:FindFirstChild("HumanoidRootPart")
        if hrp then
            local base = hrp:GetAttribute("EdsOrigSize")
            if base then hrp.Size = base end
        end
    end
end

local function ToggleHitbox(v)
    HitboxEnabled = v
    if v then
        HitboxThread = T.spawn(function()
            while HitboxEnabled do
                pcall(ApplyHitboxes)
                T.wait(0.3)
            end
        end)
    else
        if HitboxThread then T.cancel(HitboxThread) HitboxThread = nil end
        pcall(RestoreHitboxes)
    end
end

