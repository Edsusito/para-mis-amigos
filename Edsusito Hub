local function InitDragonGun()
    if ShootFunction then return true end
    local ok, result = pcall(require, ReplicatedStorage:WaitForChild("Controllers", 10):WaitForChild("CombatController", 10))
    if ok and type(result) == "table" and result.Attack then
        local okUp, fn = pcall(getupval, result.Attack, 9)
        if okUp and fn then ShootFunction = fn end
    end
    return ShootFunction ~= nil
end

local function GetNextValidator()
    if not ShootFunction and not InitDragonGun() then return 0, 0 end
    local ok, upvals = pcall(getupvals, ShootFunction)
    if not ok or not upvals then return 0, 0 end
    if upvals[V_Idx.v21] ~= 727595 then
        for i, v in pairs(upvals) do
            if v == 727595 then
                local offset = i - 15
                V_Idx.v21 = i; V_Idx.v22 = 13 + offset; V_Idx.v23 = 16 + offset
                V_Idx.v24 = 17 + offset; V_Idx.v26 = 12 + offset; V_Idx.v25 = 14 + offset
                V_Idx.v27 = 18 + offset
                break
            end
        end
    end
    local ok1, v1 = pcall(getupval, ShootFunction, V_Idx.v21)
    local ok2, v2 = pcall(getupval, ShootFunction, V_Idx.v22)
    local ok3, v3 = pcall(getupval, ShootFunction, V_Idx.v23)
    local ok4, v4 = pcall(getupval, ShootFunction, V_Idx.v24)
    local ok5, v5 = pcall(getupval, ShootFunction, V_Idx.v25)
    local ok6, v6 = pcall(getupval, ShootFunction, V_Idx.v26)
    local ok7, v7 = pcall(getupval, ShootFunction, V_Idx.v27)
    if not (ok1 and ok2 and ok3 and ok4 and ok5 and ok6 and ok7) then return 0, 0 end
    if not (v1 and v2 and v3 and v4 and v5 and v6 and v7) then return 0, 0 end
    local v8 = v6 * v2
    local v9 = (v5 * v2 + v6 * v1) % v3
    v9 = (v9 * v3 + v8) % v4
    v5 = math.floor(v9 / v3)
    v6 = v9 - v5 * v3
    v7 = v7 + 1
    pcall(setupval, ShootFunction, V_Idx.v25, v5)
    pcall(setupval, ShootFunction, V_Idx.v26, v6)
    pcall(setupval, ShootFunction, V_Idx.v27, v7)
    return math.floor(v9 / v4 * 16777215), v7
end

local function IsGun(tool)
    if not tool then return false end
    if tool.ToolTip == "Gun" then return true end
    local name = string.lower(tool.Name)
    if string.find(name, "gun") or string.find(name, "rifle") or string.find(name, "pistol") or string.find(name, "sniper") or string.find(name, "shotgun") or string.find(name, "cannon") or string.find(name, "musket") then
        return true
    end
    return false
end

local function GetGun()
    local char = localPlayer.Character
    if not char then return nil end
    local tool = char:FindFirstChildOfClass("Tool")
    if IsGun(tool) then return tool end
    local bp = localPlayer.Backpack
    if bp then
        for _, t in ipairs(bp:GetChildren()) do
            if t:IsA("Tool") and IsGun(t) then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then hum:EquipTool(t) end
                return t
            end
        end
    end
    return nil
end

local function DoGunAuraSacred()
    local char = localPlayer.Character
    if not char then return end
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool or not IsGun(tool) then return end
    local target = GetClosest(GunAuraRange)
    if not target then return end
    local tp = target:FindFirstChild("HumanoidRootPart") or target:FindFirstChild("Head")
    if not tp then return end
    if ShootGunEvent then
        local code, count = GetNextValidator()
        if code ~= 0 and Validator2 then
            pcall(function() Validator2:FireServer(code, count) end)
        end
        pcall(function()
            tool:SetAttribute("LocalOverheat", 0)
            tool:SetAttribute("LocalTotalShots", (tool:GetAttribute("LocalTotalShots") or 0) + 1)
            ShootGunEvent:FireServer(tp.Position, { tp })
        end)
    else
        pcall(function()
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then hrp.CFrame = CFrame.lookAt(hrp.Position, tp.Position) end
            tool:Activate()
        end)
    end
end

local function ToggleGunAura(v)
    GunAuraEnabled = v
    if v then
        GunThread = T.spawn(function()
            while GunAuraEnabled do
                pcall(DoGunAuraSacred)
                T.wait(0.085)
            end
        end)
    elseif GunThread then
        T.cancel(GunThread)
        GunThread = nil
    end
end

-- ==========================================================
-- 6) FLY (funciones estilo FlyGui: sin su GUI)
-- Controles: WASD + mouse | ESPACIO = subir | SHIFT = bajar
-- ==========================================================
local FlyEnabled = false
local FlySpeed = 70
local flyConnection = nil
local flyAtt, flyVel, flyOri

local function StartFly()
    local char = localPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    StopFly()
    flyAtt = Instance.new("Attachment")
    flyAtt.Parent = hrp
    flyVel = Instance.new("LinearVelocity")
    flyVel.Attachment0 = flyAtt
    flyVel.MaxForce = math.huge
    flyVel.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
    flyVel.Parent = hrp
    flyOri = Instance.new("AlignOrientation")
    flyOri.Attachment0 = flyAtt
    flyOri.Mode = Enum.OrientationAlignmentMode.OneAttachment
    flyOri.MaxTorque = math.huge
    flyOri.Responsiveness = 150
    flyOri.Parent = hrp
    FlyEnabled = true
    flyConnection = RunService.Heartbeat:Connect(function()
        pcall(function()
            local hum = char:FindFirstChildOfClass("Humanoid")
            local cam = Workspace.CurrentCamera
            if not hum or not cam then return end
            local look = cam.CFrame.LookVector
            local flat = Vector3.new(look.X, 0, look.Z).Unit
            local camFlat = CFrame.lookAt(Vector3.zero, flat)
            local move = hum.MoveDirection
            local world = camFlat:VectorToWorldSpace(move)
            local vel = Vector3.new(world.X * FlySpeed, 0, world.Z * FlySpeed)
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then vel = vel + Vector3.new(0, FlySpeed, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then vel = vel - Vector3.new(0, FlySpeed, 0) end
            flyVel.VectorVelocity = vel
            flyOri.CFrame = CFrame.lookAt(Vector3.zero, flat)
        end)
    end)
end

local function StopFly()
    if flyConnection then flyConnection:Disconnect() flyConnection = nil end
    if flyVel then flyVel:Destroy() flyVel = nil end
    if flyOri then flyOri:Destroy() flyOri = nil end
    if flyAtt then flyAtt:Destroy() flyAtt = nil end
    FlyEnabled = false
end

local function ToggleFly(v)
    if v then
        StartFly()
    else
        StopFly()
    end
end

