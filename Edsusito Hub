        },
    })
    New("TextLabel", {
        Size = UDim2.new(1, -S(110), 0, S(18)),
        Position = UDim2.new(0, S(18), 0, S(5)),
        BackgroundTransparency = 1,
        Text = name,
        TextXAlignment = Enum.TextXAlignment.Left,
        Font = Enum.Font.GothamSemibold,
        TextSize = S(12),
        TextColor3 = Color3.fromRGB(255, 255, 255),
        TextTransparency = 0.35,
        Parent = box,
    })
    local pill = New("TextLabel", {
        Size = UDim2.new(0, S(62), 0, S(22)),
        Position = UDim2.new(1, -S(82), 0, S(4)),
        BackgroundColor3 = cyan,
        BackgroundTransparency = 0.86,
        Text = tostring(current) .. suffix,
        Font = Enum.Font.GothamBold,
        TextSize = S(11),
        TextColor3 = cyan,
        TextXAlignment = Enum.TextXAlignment.Center,
        Parent = box,
        Children = {
            New("UICorner", { CornerRadius = UDim.new(0, S(5)) }),
            New("UIStroke", { Color = cyan, Transparency = 0.8, Thickness = 1 }),
        },
    })
    local track = New("Frame", {
        Size = UDim2.new(1, -S(36), 0, S(6)),
        Position = UDim2.new(0, S(18), 0, S(44)),
        BackgroundColor3 = Color3.fromRGB(34, 34, 34),
        BorderSizePixel = 0,
        Parent = box,
        Children = { New("UICorner", { CornerRadius = UDim.new(1, 0) }) },
    })
    local fill = New("Frame", {
        Size = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = cyan,
        BorderSizePixel = 0,
        Parent = track,
        Children = { New("UICorner", { CornerRadius = UDim.new(1, 0) }) },
    })
    local snob = New("TextButton", {
        Size = UDim2.new(0, S(18), 0, S(18)),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
        Parent = track,
        Children = {
            New("UICorner", { CornerRadius = UDim.new(1, 0) }),
            New("UIStroke", { Color = cyan, Thickness = 1, Transparency = 0.4 }),
        },
    })
    local dragging = false
    local function SetX(x)
        local w = track.AbsoluteSize.X
        if w <= 0 then return end
        local rel = Clamp((x - track.AbsolutePosition.X) / w, 0, 1)
        local v = math.floor(min + (max - min) * rel + 0.5)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        snob.Position = UDim2.new(rel, 0, 0.5, 0)
        pill.Text = tostring(v) .. suffix
    end
    snob.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            SetX(input.Position.X)
        end
    end)
    snob.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            SetX(input.Position.X)
        end
    end)
    local initRel = Clamp((current - min) / (max - min), 0, 1)
    fill.Size = UDim2.new(initRel, 0, 1, 0)
    snob.Position = UDim2.new(initRel, 0, 0.5, 0)
end

